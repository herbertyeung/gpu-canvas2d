{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "GPU Canvas 2D",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "build",
      "architecture": "x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "GPU2D_USE_SKIA": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release"
    }
  ]
}
